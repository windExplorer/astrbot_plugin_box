{
    "only_admin": {
        "description": "仅Bot管理员可查询他人资料",
        "type": "bool",
        "hint": "但查询自己的资料不受限制",
        "default": false
    },
    "protect_ids": {
        "description": "信息保护用户",
        "type": "list",
        "hint": "查询时，会忽略名单中的用户。注意：Bot管理员已默认被保护（Bot 管理面板中的管理员名单），除非管理员亲自查询自己，否则无法被查询；Bot 自己可以正常被查询",
        "default": []
    },
    "autobox": {
        "description": "自动展示配置",
        "type": "object",
        "hint": "",
        "items": {
            "white_groups": {
                "description": "自动展示群聊白名单",
                "type": "list",
                "hint": "只自动展示白名单群聊中新群友/主动退群之人的资料卡，不填则默认所有群聊都启用自动展示",
                "default": []
            },
            "enter": {
                "description": "自动展示新进群成员的资料卡",
                "type": "bool",
                "default": false
            },
            "exit": {
                "description": "自动展示主动退群成员的资料卡",
                "type": "bool",
                "default": false
            }
        }
    },
