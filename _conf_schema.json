            "登录天数",
            "隐藏QQ等级",
            "隐藏特权图标",
            "签名"
        ]
    },
    "recall_time": {
        "description": "撤回时间(秒)",
        "hint": "几秒后撤回资料卡，设为 0 则不撤回",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 110,
            "step": 1
        },
        "default": 10
    },
    "desensitize": {
        "description": "信息脱敏",
        "type": "bool",
        "hint": "对敏感信息进行脱敏处理，一般用不到，正常使用时没有敏感信息",
        "default": true
    },
    "ai_analysis": {
        "description": "AI 分析（消耗 token，需已配置 LLM）",
        "type": "object",
        "hint": "开启后卡片会展示对应的分析点评，三项相互独立",
        "items": {
            "avatar_analysis": {
                "description": "头像分析",
                "type": "bool",
                "hint": "让 LLM 看头像并写一句点评",
                "default": false
            },
            "signature_analysis": {
                "description": "签名解读",
                "type": "bool",
                "hint": "让 LLM 解读个性签名（对方没写签名时不展示）",
                "default": false
            },
            "overall_analysis": {
                "description": "综合锐评",
                "type": "bool",
                "hint": "让 LLM 整合全部资料和头像写一句锐评",
                "default": false
            },
            "event_analysis": {
                "description": "退群/被踢卡 AI 分析",
                "type": "bool",
                "hint": "开启后退群卡和被踢卡也按上面的开关调用 LLM；默认关闭，退群/被踢卡不调用（入群卡始终按上面的开关执行）",
                "default": false
            }
        }
    },
    "record_join_leave": {
        "description": "记录入群/退群精确时间",
        "type": "bool",
        "hint": "用本地 SQLite 数据库记录群成员入群、退群的精确时间（精确到秒）。卡片上的加群时间优先使用库里的精确值；退群成员的卡片也能显示加群/退群时间",
        "default": true
    },
    "cache_cooldown": {
        "description": "资料卡缓存冷却（分钟）",
        "type": "int",
        "hint": "同一群同一用户在冷却时间内再次获取时，直接使用数据库保存的上一张卡片，不重新请求接口和 LLM（入群/退群/被踢事件卡不受冷却限制，始终实时获取并刷新缓存）；0 为关闭",
        "slider": {
            "min": 0,
            "max": 720,
            "step": 1
        },
        "default": 15
    },
    "max_concurrent": {
        "description": "并发获取数",
        "type": "int",
        "hint": "全局限流：所有群所有用户同时最多 N 个资料获取任务在请求接口/LLM，其余按顺序排队；走缓存的不排队",
        "slider": {
            "min": 1,
            "max": 10,
            "step": 1
        },
        "default": 1
    },
    "welcome_enabled": {
        "description": "入群欢迎语",
        "type": "bool",
        "hint": "在入群卡片内展示欢迎语区块（需开启自动展示入群卡）",
        "default": true
    },
    "welcome_text": {
        "description": "欢迎语模板",
        "type": "string",
        "hint": "支持 {name} 与 {count_text} 占位符；{count_text} 会替换为「你是本群第 N 位成员（共 M 人）」",
        "default": "🎉 欢迎 {name} 加入本群！\n{count_text}"
    },
    "welcome_images": {
        "description": "欢迎图片池",
        "type": "list",
        "hint": "http/https 图片链接，支持 PNG/JPG/WebP 等常见格式（按内容识别，与后缀无关；动图取第一帧）。入群卡内随机嵌入一张（下载失败则只显示文字），留空不嵌入",
        "default": []
    },
    "welcome_ai_enabled": {
        "description": "AI 欢迎语",
        "type": "bool",
        "hint": "开启后在欢迎语后追加一句 LLM 生成的个性化欢迎语（消耗 token）",
        "default": false
    },
    "welcome_ai_prompt": {
        "description": "AI 欢迎语提示词",
        "type": "string",
        "hint": "{name} 会替换为新成员昵称",
        "default": "请根据以下昵称，生成一句简短、温暖、有趣的入群欢迎语：{name}"
    },
    "welcome_ai_retry": {
        "description": "AI 欢迎语重试次数",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 5,
            "step": 1
        },
        "default": 1
    },
    "welcome_private_rules": {
        "description": "私聊发送群规",
        "type": "bool",
        "hint": "新成员入群展示卡片刻钟，私聊发送一段群规文本",
        "default": false
    },
    "group_rules": {
        "description": "群规文本",
        "type": "string",
        "hint": "开启私聊群规后发送的内容",
        "default": "📋 请遵守群规，友善交流！"
    },
    "black_groups": {
        "description": "群黑名单",
        "type": "list",
        "hint": "自动展示的排除名单；白名单为空时生效（白名单优先）",
        "default": []
    },
    "mystery_url": {
        "description": "拓展配置项",
        "hint": "无需填写，仅供开发人员使用",
        "type": "string",
        "default": ""
    },
    "mystery_cookies": {
        "description": "cookies",
        "hint": "",
        "type": "string",
        "invisible": true,
        "default": ""
    }
}