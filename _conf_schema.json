    "recall_time": {
        "description": "撤回时间(秒)",
        "hint": "几秒后撤回资料卡，设为 0 则不撤回",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 110,
            "step": 1
        },
        "default": 10
    },
    "desensitize": {
        "description": "信息脱敏",
        "type": "bool",
        "hint": "对敏感信息进行脱敏处理，一般用不到，正常使用时没有敏感信息",
        "default": true
    },
    "ai_analysis": {
        "description": "AI 分析（消耗 token，需已配置 LLM）",
        "type": "object",
        "hint": "开启后卡片会展示对应的分析点评，三项相互独立",
        "items": {
            "avatar_analysis": {
                "description": "头像分析",
                "type": "bool",
                "hint": "让 LLM 看头像并写一句点评",
                "default": false
            },
            "signature_analysis": {
                "description": "签名解读",
                "type": "bool",
                "hint": "让 LLM 解读个性签名（对方没写签名时不展示）",
                "default": false
            },
            "overall_analysis": {
                "description": "综合锐评",
                "type": "bool",
                "hint": "让 LLM 整合全部资料和头像写一句锐评",
                "default": false
            }
        }
    },
    "record_join_leave": {
        "description": "记录入群/退群精确时间",
        "type": "bool",
        "hint": "用本地 SQLite 数据库记录群成员入群、退群的精确时间（精确到秒）。卡片上的加群时间优先使用库里的精确值；退群成员的卡片也能显示加群/退群时间",
        "default": true
    },
    "mystery_url": {
        "description": "拓展配置项",
        "hint": "无需填写，仅供开发人员使用",
        "type": "string",
        "default": ""
    },
    "mystery_cookies": {
        "description": "cookies",
        "hint": "",
        "type": "string",
        "invisible": true,
        "default": ""
    }
